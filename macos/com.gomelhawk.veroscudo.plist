<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.gomelhawk.veroscudo</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/veroscudo</string>
        <string>daemon</string>
    </array>
    <!-- at boot: re-applies the kill-switch when armed (pf anchors do not survive a reboot), then watches and redials -->
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/var/log/veroscudo.out</string>
    <key>StandardErrorPath</key><string>/var/log/veroscudo.out</string>
</dict>
</plist>
